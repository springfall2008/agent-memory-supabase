{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check supabase/functions scripts/*.ts scripts/lib tests web/lib web/server.ts",
    "test:unit": "deno test -A tests/unit",
    "test:int": "deno test -A tests/integration",
    "test:e2e": "deno test -A tests/e2e",
    "test:db": "supabase test db",
    "web": "deno run --allow-net --allow-read --allow-env --env-file=.env web/server.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "exclude": [
      "docs",
      "spike",
      "supabase/.temp",
      ".superpowers",
      ".remember",
      "README.md",
      "web/public/vendor"
    ]
  },
  "lint": {
    "exclude": [
      "docs",
      "spike",
      "web/public/vendor"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
